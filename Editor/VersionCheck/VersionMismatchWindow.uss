* {
    cursor: arrow;
}

#root-box {
    flex-grow: 1;
    padding: 16px 16px 8px 16px;
    background-color: var(--unity-colors-window-background);
}

TemplateContainer {
    height: 100%;
}

LogoImage {
    margin-bottom: 12px;
}

.title {
    align-self: center;
    margin-bottom: 20px;
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.warning-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 20px;
    padding: 10px;
    background-color: rgba(255, 188, 0, 0.12);
    border-color: rgba(255, 188, 0, 0.8);
    border-width: 1px;
}

.warning-icon {
    width: 24px;
    height: 24px;
    margin-right: 10px;
    flex-shrink: 0;
}

.warning-text {
    flex-grow: 1;
    white-space: normal;
    -unity-font-style: bold;
}

.instructions {
    margin-bottom: 8px;
}

.version-panel {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: 20px;
    padding: 10px;
    background-color: rgba(0, 0, 0, 0.1);
}

.version-row {
    flex-direction: column;
    align-items: center;
    width: 140px;
}

.version-label {
    width: 100%;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.required-version,
.installed-version {
    width: 120px;
}

.version-number {
    -unity-text-align: middle-center;
}

.required-version {
    color: rgb(255, 180, 80);
}

.installed-version {
    color: rgb(255, 125, 125);
}

.affected-assets-heading {
    margin-bottom: 8px;
    -unity-font-style: bold;
}

.affected-assets {
    flex-grow: 1;
    min-height: 120px;
    border-color: var(--unity-colors-separator-background);
    border-width: 1px;
    background-color: rgba(0, 0, 0, 0.08);
}

.asset-entry {
    padding: 5px 8px;
    white-space: normal;
}

.actions {
    flex-direction: column;
    align-items: flex-end;
    margin-top: 12px;
}

.button-row {
    align-self: stretch;
    flex-direction: row;
    justify-content: center;
}

.upgrade-button,
.refresh-button,
.close-unity-button {
    min-width: 120px;
    min-height: 30px;
}

.upgrade-button {
    background-color: rgb(112, 182, 232);
    color: rgb(20, 45, 65);
}

.upgrade-button:hover {
    background-color: rgb(140, 200, 255);
}

.refresh-button {
    margin-left: 6px;
    background-color: rgb(210, 210, 210);
    color: rgb(45, 45, 45);
}

.refresh-button:hover {
    background-color: rgb(230, 230, 230);
}

.close-unity-button {
    margin-left: 6px;
    background-color: rgb(237, 150, 150);
    color: rgb(70, 25, 25);
}

.close-unity-button:hover {
    background-color: rgb(255, 130, 130);
}

.ignore-link {
    margin-top: 5px;
    padding: 0;
    min-width: 0;
    min-height: 0;
    background-color: transparent;
    border-width: 0;
    color: rgb(105, 175, 225);
    font-size: 11px;
    cursor: link;
}

.ignore-link:hover {
    color: rgb(145, 205, 245);
}

.ignore-risk {
    margin-top: 2px;
    opacity: 0.6;
    font-size: 10px;
}

.row {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
}

.language-switcher {
    align-self: center;
    flex-shrink: 0;
    width: 100%;
}
